# Local SQLite database created by Prisma
DATABASE_URL="file:./dev.db"

# Google OAuth values from Google Cloud Console
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Secret used to protect the login session
AUTH_SECRET="replace-with-your-own-secret"

# Local URL used while developing the project
NEXTAUTH_URL="http://localhost:3000"
